<html lang="nl" style="margin: 0; padding: 0">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{subject}}</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!--[if mso]>
      <style type="text/css">
        * {
          font-family: Arial, sans-serif !important;
        }
      </style>
    <![endif]-->
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background: f1f1f1;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      font-family: 'Open Sans', sans-serif;
    "
  >
    <div
      style="
        display: none;
        overflow: hidden;
        line-height: 1px;
        opacity: 0;
        max-height: 0;
        max-width: 0;
      "
    >
      Bevestiging van je inschrijving voor het Turnfeest - bekijk het overzicht hieronder.
    </div>

    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background: #f5f7fb"
    >
      <tr>
        <td align="center" style="padding: 24px">
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="max-width: 640px; background: #ffffff; border-radius: 12px; overflow: hidden"
          >
            <tr>
              <td
                style="
                  background: #202020;
                  color: #ffffff;
                  padding-top: 16px;
                  padding-right: 24px;
                  padding-bottom: 16px;
                  padding-left: 24px;
                  font-family: 'Open Sans', sans-serif;
                  position: relative;
                "
              >
                <img
                  src="https://www.hamseturnvereniging.be/cdn-cgi/image/w=160,h=160,q=100,fit=cover/images/logo.png"
                  height="80"
                  alt="Hamse Turnvereniging logo"
                />
              </td>
            </tr>

            <tr>
              <td
                style="
                  padding: 18px 24px;
                  color: #0f172a;
                  font-size: 14px;
                  line-height: 1.6;
                  font-family: 'Open Sans', sans-serif;
                "
              >
                <h1
                  style="
                    color: #a0ef94;
                    margin: 0 0 12px;
                    font-size: 20px;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Bevestiging inschrijving
                </h1>
                <p style="margin: 0 0 12px">Dag {{contact.firstName}},</p>
                <p style="margin: 0">
                  Bedankt voor je inschrijving voor het Turnfeest van de Hamse Turnvereniging.
                  Hieronder vind je een overzicht van de gegevens die we hebben ontvangen.
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding: 12px 24px 0">
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Activiteit
                </h2>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    border-collapse: collapse;
                    font-size: 14px;
                    color: #0f172a;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  <tr>
                    <td width="34%" style="padding: 6px 6px 6px 0px">Activiteit</td>
                    <td style="padding: 6px 0"><strong>Turnfeest 2027 - Aladdin</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px; vertical-align: top">Generale repetitie</td>
                    <td style="padding: 6px 0"><strong>Zaterdag 13 maart 2027 van 10u tot 12u</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px; vertical-align: top">Turnfeest</td>
                    <td style="padding: 6px 0"><strong>Zaterdag 20 maart 2027 om 14u30</strong><br />Leden
                      worden tussen 13u30 en 14u verwacht (uur wordt nog meegedeeld per groep)</td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px">Locatie</td>
                    <td style="padding: 6px 0"><strong>Sporthal Kristoffelheem</strong></td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 12px 24px 0">
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Deelnemer
                </h2>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    border-collapse: collapse;
                    font-size: 14px;
                    color: #0f172a;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  <tr>
                    <td width="34%" style="padding: 6px 6px 6px 0px">Voornaam</td>
                    <td style="padding: 6px 0"><strong>{{firstName}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px">Naam</td>
                    <td style="padding: 6px 0"><strong>{{lastName}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px; vertical-align: top">Groep(en)</td>
                    <td style="padding: 6px 0">
                      {{#each groups}}<strong>{{this}}</strong>{{#unless @last}}<br />{{/unless}}{{/each}}
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px; vertical-align: top">Mogen er foto's gemaakt
                      worden?</td>
                    <td style="padding: 6px 0; vertical-align: top">
                      <strong>{{#if (eq photos "Ja")}}✅ Ja{{else}}❌ Nee{{/if}}</strong>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px; vertical-align: top">Toneel</td>
                    <td style="padding: 6px 0"><strong>{{theatre}}</strong></td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 12px 24px 0">
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Contactpersoon
                </h2>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    border-collapse: collapse;
                    font-size: 14px;
                    color: #0f172a;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  <tr>
                    <td width="34%" style="padding: 6px 6px 6px 0px">Voornaam</td>
                    <td style="padding: 6px 0"><strong>{{contact.firstName}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px">Naam</td>
                    <td style="padding: 6px 0"><strong>{{contact.lastName}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px">Telefoon</td>
                    <td style="padding: 6px 0">
                      <a
                        href="tel:{{contact.phoneNumber}}"
                        style="color: #0f172a; text-decoration: none"
                      ><strong>{{contact.phoneNumber}}</strong></a>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0px">E-mail</td>
                    <td style="padding: 6px 0">
                      <a
                        href="mailto:{{contact.email}}"
                        style="color: #0f172a; text-decoration: none"
                      ><strong>{{contact.email}}</strong></a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            {{#if joinsTheatre}}
            <!-- Toneel -->
            <tr>
              <td style="padding: 12px 24px 0">
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Toneel
                </h2>
                <p style="margin: 0 0 8px; font-size: 14px; color: #0f172a">
                  De repetities voor het toneel vinden plaats op zaterdagvoormiddag van 9u30 tot
                  10u30 op 23 januari, 30 januari, 6 februari, 20 februari, 27 februari en 6 maart.
                  Op 13 februari is er geen repetitie (Krokusvakantie).
                </p>
                <p style="margin: 0; font-size: 14px; color: #0f172a">
                  We rekenen op een maximale aanwezigheid tijdens deze repetities, zodat iedereen
                  zijn of haar rol goed kan voorbereiden.
                </p>
              </td>
            </tr>
            {{/if}}

            <tr>
              <td style="padding: 12px 24px 0">
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Praktische info
                </h2>
                <p style="margin: 0 0 8px; font-size: 14px; color: #0f172a">
                  Zodra je kind is ingeschreven, rekenen we op zijn/haar/x aanwezigheid op de
                  generale repetitie en het turnfeest.
                </p>
                <p style="margin: 0; font-size: 14px; color: #0f172a">
                  Meer informatie over het verloop van de dag en de kledij die de leden moeten
                  dragen ontvang je binnenkort.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  padding: 12px 24px 24px;
                  font-size: 12px;
                  line-height: 1.6;
                  font-family: 'Open Sans', sans-serif;
                "
              >
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <p style="margin: 0">
                  Vragen? Of klopt er iets niet? Antwoord op deze e-mail met de correcties. Mail ons
                  via
                  <a
                    href="mailto:info@hamseturnvereniging.be"
                    style="color: #059e95; text-decoration: none"
                  >info@hamseturnvereniging.be</a>.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>