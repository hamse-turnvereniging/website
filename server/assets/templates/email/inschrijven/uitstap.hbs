<html lang="nl" style="margin: 0; padding: 0">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{subject}}</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!--[if mso]>
      <style type="text/css">
        * {
          font-family: Arial, sans-serif !important;
        }
      </style>
    <![endif]-->
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background: #f1f1f1;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      font-family: 'Open Sans', sans-serif;
    "
  >
    <div
      style="
        display: none;
        overflow: hidden;
        line-height: 1px;
        opacity: 0;
        max-height: 0;
        max-width: 0;
      "
    >
      Bevestiging van je inschrijving voor de uitstap naar Trampolinepark Geel.
    </div>

    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background: #f5f7fb"
    >
      <tr>
        <td align="center" style="padding: 24px">
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="max-width: 640px; background: #ffffff; border-radius: 12px; overflow: hidden"
          >
            <tr>
              <td
                style="
                  background: #202020;
                  color: #ffffff;
                  padding: 16px 24px;
                  font-family: 'Open Sans', sans-serif;
                "
              >
                <img
                  src="https://www.hamseturnvereniging.be/cdn-cgi/image/w=160,h=160,q=100,fit=cover/images/logo.png"
                  height="80"
                  alt="Hamse Turnvereniging logo"
                />
              </td>
            </tr>

            <tr>
              <td
                style="
                  padding: 18px 24px;
                  color: #0f172a;
                  font-size: 14px;
                  line-height: 1.6;
                  font-family: 'Open Sans', sans-serif;
                "
              >
                <h1
                  style="
                    color: #a0ef94;
                    margin: 0 0 12px;
                    font-size: 20px;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Bevestiging inschrijving
                </h1>
                <p style="margin: 0 0 12px">Dag {{contact.firstName}},</p>
                <p style="margin: 0">
                  Bedankt voor je inschrijving voor de grote uitstap naar Trampolinepark Geel.
                  Hieronder vind je een overzicht van de gegevens die we hebben ontvangen.
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding: 12px 24px 0">
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Activiteit
                </h2>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    border-collapse: collapse;
                    font-size: 14px;
                    color: #0f172a;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  <tr>
                    <td width="34%" style="padding: 6px 6px 6px 0">Activiteit</td>
                    <td style="padding: 6px 0"><strong>Trampolinepark Geel</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Wanneer</td>
                    <td style="padding: 6px 0"><strong>zaterdag 27 juni 2026</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Vertrek</td>
                    <td style="padding: 6px 0"><strong>9u45 aan Sporthal Kristoffelheem</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Terugkomst</td>
                    <td style="padding: 6px 0"><strong>Rond 12u30</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Prijs</td>
                    <td style="padding: 6px 0"><strong>&euro; {{amount}}</strong></td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 12px 24px 0">
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Deelnemer
                </h2>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    border-collapse: collapse;
                    font-size: 14px;
                    color: #0f172a;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  <tr>
                    <td width="34%" style="padding: 6px 6px 6px 0">Voornaam</td>
                    <td style="padding: 6px 0"><strong>{{firstName}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Naam</td>
                    <td style="padding: 6px 0"><strong>{{lastName}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Groep</td>
                    <td style="padding: 6px 0"><strong>{{group}}</strong></td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 12px 24px 0">
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Contactpersoon
                </h2>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    border-collapse: collapse;
                    font-size: 14px;
                    color: #0f172a;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  <tr>
                    <td width="34%" style="padding: 6px 6px 6px 0">Voornaam</td>
                    <td style="padding: 6px 0"><strong>{{contact.firstName}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Naam</td>
                    <td style="padding: 6px 0"><strong>{{contact.lastName}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Telefoon</td>
                    <td style="padding: 6px 0">
                      <a
                        href="tel:{{contact.phoneNumber}}"
                        style="color: #0f172a; text-decoration: none"
                      ><strong>{{contact.phoneNumber}}</strong></a>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">E-mail</td>
                    <td style="padding: 6px 0">
                      <a
                        href="mailto:{{contact.email}}"
                        style="color: #0f172a; text-decoration: none"
                      ><strong>{{contact.email}}</strong></a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 12px 24px 0">
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Vervoer en betaling
                </h2>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="font-size: 14px; color: #0f172a; font-family: 'Open Sans', sans-serif"
                >
                  <tr>
                    <td width="34%" style="padding: 6px 6px 6px 0">Kan helpen met vervoer</td>
                    <td style="padding: 6px 0"><strong>{{transport}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Rekeningnummer</td>
                    <td style="padding: 6px 0"><strong>BE69 0682 0939 9078</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Bedrag</td>
                    <td style="padding: 6px 0"><strong>&euro; {{amount}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Mededeling</td>
                    <td style="padding: 6px 0"><strong>Uitstap {{firstName}} {{lastName}}</strong></td>
                  </tr>
                  <tr>
                    <td style="padding: 6px 6px 6px 0">Ik heb reeds betaald of de betaalgegevens
                      zorgvuldig genoteerd.</td>
                    <td style="padding: 6px 0">
                      <strong>{{#if paymentCheck}}Ja{{else}}Nee{{/if}}</strong>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 12px 24px 0">
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <h2
                  style="
                    margin: 0 0 8px;
                    font-size: 16px;
                    color: #059e95;
                    font-weight: 700;
                    font-family: 'Open Sans', sans-serif;
                  "
                >
                  Praktische info
                </h2>
                <p style="margin: 0 0 8px; font-size: 14px; color: #0f172a">
                  Breng anti-slipsokken mee als je die hebt.
                </p>
                <p style="margin: 0; font-size: 14px; color: #0f172a">
                  We rijden met de auto en bekijken op basis van de inschrijvingen of extra hulp van
                  ouders nodig is.
                </p>
              </td>
            </tr>

            <tr>
              <td
                style="
                  padding: 12px 24px 24px;
                  font-size: 12px;
                  line-height: 1.6;
                  font-family: 'Open Sans', sans-serif;
                "
              >
                <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0 0 12px" />
                <p style="margin: 0">
                  Vragen? Of klopt er iets niet? Antwoord op deze e-mail met de correcties. Mail ons
                  via
                  <a
                    href="mailto:info@hamseturnvereniging.be"
                    style="color: #059e95; text-decoration: none"
                  >info@hamseturnvereniging.be</a>.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
